rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Money Tracker Bot & Mini App Security Rules
    // Tenant isolation: Authenticated users can only read and write their own records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow connection health-check verification
    match /test/connection {
      allow read: if true;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
