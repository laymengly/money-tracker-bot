# Telegram Bot Token (Obtained from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Optional Telegram Webhook Secret Token (Enforces verification on /api/telegram-webhook)
TELEGRAM_WEBHOOK_SECRET=

# Path to Firebase Admin SDK Service Account JSON Key
# (When deployed on Firebase / Google Cloud, Application Default Credentials are used automatically)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# WebApp URL (For Telegram Mini App button)
# In production on Firebase, set this to your Firebase Hosting domain: https://<your-project-id>.web.app
WEBAPP_URL=http://localhost:8000

# Mini App Server Settings (for local development)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
